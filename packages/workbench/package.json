{
  "name": "@runtime-inspector/workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime Inspector motion workbench shell.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "desktop": "electron electron/main.mjs --dev",
    "test": "node --test electron/*.test.mjs",
    "benchmark:framebuffer": "node electron/framebuffer-benchmark.mjs",
    "benchmark:framebuffer:gate": "node electron/framebuffer-benchmark.mjs --gate-profile balanced --max-relative-p95 0.90 --max-relative-bytes 0.85 --max-psnr-loss-db 1.10"
  },
  "dependencies": {
    "@runtime-inspector/panel-core": "workspace:*",
    "@runtime-inspector/protocol": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.3",
    "typescript": "^5.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "electron": "44.0.0"
  }
}
