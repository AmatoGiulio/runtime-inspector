{
  "name": "@runtime-inspector/panel-core",
  "version": "0.1.0",
  "description": "Framework-agnostic panel session logic for Runtime Inspector (connection, schema store, patch throttling, A/B compare, TypeScript export).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmatoGiulio/runtime-inspector.git",
    "directory": "packages/panel-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "pnpm --filter @runtime-inspector/protocol build && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@runtime-inspector/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
