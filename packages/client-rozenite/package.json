{
  "name": "@runtime-inspector/client-rozenite",
  "version": "0.1.0",
  "description": "Rozenite plugin: renders the Runtime Inspector panel inside React Native DevTools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmatoGiulio/runtime-inspector.git",
    "directory": "packages/client-rozenite"
  },
  "type": "module",
  "files": [
    "dist",
    "react-native.ts",
    "rozenite.config.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rozenite build .",
    "dev": "rozenite dev .",
    "test": "echo \"no tests\" && exit 0",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@runtime-inspector/panel-core": "workspace:*",
    "@runtime-inspector/panel-react": "workspace:*",
    "@runtime-inspector/protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@rozenite/vite-plugin": "^1.13.0",
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "rozenite": "^1.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "main": "./dist/react-native/index.cjs",
  "module": "./dist/react-native/index.js",
  "types": "./dist/react-native/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js",
      "require": "./dist/react-native/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
