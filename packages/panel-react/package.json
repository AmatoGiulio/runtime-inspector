{
  "name": "@runtime-inspector/panel-react",
  "version": "0.1.0",
  "description": "Shared React control components for Runtime Inspector panels (web and Rozenite/React Native DevTools).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmatoGiulio/runtime-inspector.git",
    "directory": "packages/panel-react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css"],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@runtime-inspector/panel-core": "workspace:*",
    "@runtime-inspector/protocol": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "react": "18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
